--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 16356fe3b9ef6fc4cb033cf0da1bdbec, type: 3}
  m_Name: TutorialPieces
  m_EditorClassIdentifier: 
  pages:
  - image: {fileID: 21300000, guid: b84b2768ae4f42b4ab6804dc7dd2d962, type: 3}
    description: 'Each color shows what the piece can do on that square.

      Green:
      movement only.

      Red: capture only.

      Yellow: movement + capture.

      Blue:
      jump movement.

      Purple: jump + capture.'
  - image: {fileID: 21300000, guid: e70eb1da73412c947906c73c270e93e4, type: 3}
    description: 'In Moves, you shape how the piece behaves on the board.

      Define
      how far it can go, which directions it can move, and what type of action the
      move allows.

      Each adjustment changes the strategy and creates new gameplay
      possibilities.'
  - image: {fileID: 21300000, guid: 3042319b692afe84eb122c5f4f9d503b, type: 3}
    description: "The special move is a unique ability of the Pawn that can only
      be used once.\nJust like the Knight\u2019s custom movement, simply select the
      desired squares and activate the move."
  - image: {fileID: 21300000, guid: 8186bac7c661d804eb742c591c98ee58, type: 3}
    description: 'After finishing a piece, use the Reset button to clear the data
      and create a new piece from scratch.

      Warning: creating a new piece without
      resetting and using Quick Save will overwrite the previous piece.'
  - image: {fileID: 21300000, guid: 4cb2050ff0ab07c40a027386d7393ad2, type: 3}
    description: 'When clicking Save, the available sets will be shown next. Click
      the desired set again to confirm saving.

      In the top-right corner, you
      can create a new set.

      To delete, click Delete, select the desired set,
      and confirm the action.'
