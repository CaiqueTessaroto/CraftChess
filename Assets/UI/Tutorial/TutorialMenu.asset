MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 16356fe3b9ef6fc4cb033cf0da1bdbec, type: 3}
  m_Name: TutorialMenu
  m_EditorClassIdentifier: 
  pages:
  - image: {fileID: 21300000, guid: 998c995bb5ee2284689dc3135e771633, type: 3}
    description: "Crie as artes que ser\xE3o usadas em suas pe\xE7as nas propor\xE7\xF5es
      de 17x17 e 34x34. Tamb\xE9m \xE9 poss\xEDvel importar imagens, que ser\xE3o
      convertidas para o grid automaticamente."
  - image: {fileID: 21300000, guid: 8646145575cf5c64e847bcd1d08ce879, type: 3}
    description: "Ap\xF3s criar sua arte, transforme-a em uma pe\xE7a do tabuleiro.\nEssa
      pe\xE7a representa o movimento que voc\xEA acabou de criar."
  - image: {fileID: 21300000, guid: 467148fb260c4aa46a79ea859a49e34d, type: 3}
    description: "Com suas pe\xE7as prontas, \xE9 hora de montar o seu esquadr\xE3o.\nOrganize
      as pe\xE7as no tabuleiro da forma que desejar e defina qual ser\xE1 o rei."
  - image: {fileID: 21300000, guid: d80a624c5e472be479ab4e8f777bd368, type: 3}
    description: "No lobby, selecione quais esquadr\xF5es jogar\xE3o com as pe\xE7as
      pretas e brancas clicando no tabuleiro.\nEm seguida, escolha com qual deles
      voc\xEA ir\xE1 jogar  indicado pela cor da coroa.\nOp\xE7\xF5es extras de jogo
      est\xE3o dispon\xEDveis no canto superior direito."
  - image: {fileID: 21300000, guid: 561fb7b20d22f2848bc5aad414f63f5e, type: 3}
    description: "Agora \xE9 s\xF3 jogar a partida.\nNo canto superior esquerdo,
      voc\xEA pode se render caso a situa\xE7\xE3o fique dif\xEDcil.\nNo canto superior
      direito, est\xE3o as op\xE7\xF5es de visualiza\xE7\xE3o.\n\xC0 direita da tela,
      voc\xEA pode acompanhar o hist\xF3rico de movimentos."
