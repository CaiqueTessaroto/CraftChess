MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 16356fe3b9ef6fc4cb033cf0da1bdbec, type: 3}
  m_Name: TutorialMenu
  m_EditorClassIdentifier: 
  pages:
  - image: {fileID: 21300000, guid: 998c995bb5ee2284689dc3135e771633, type: 3}
    description: Create the artwork that will be used for your pieces in 17x17 and
      34x34 proportions. You can also import images, which will be automatically
      converted to the grid.
  - image: {fileID: 21300000, guid: 8646145575cf5c64e847bcd1d08ce879, type: 3}
    description: 'After creating your artwork, turn it into a board piece.

      This
      piece represents the movement you just created.'
  - image: {fileID: 21300000, guid: 467148fb260c4aa46a79ea859a49e34d, type: 3}
    description: "With your pieces ready, it\u2019s time to build your squad.\nArrange
      the pieces on the board however you like and define which one will be the King."
  - image: {fileID: 21300000, guid: d80a624c5e472be479ab4e8f777bd368, type: 3}
    description: 'In the lobby, select which squads will play as black and white
      pieces by clicking on the board.

      Then choose which one you will play
      with, indicated by the crown color.

      Additional game options are available
      in the top-right corner.'
  - image: {fileID: 21300000, guid: 561fb7b20d22f2848bc5aad414f63f5e, type: 3}
    description: "Now it\u2019s time to play the match.\nIn the top-left corner,
      you can surrender if the situation becomes difficult.\nIn the top-right corner
      are the view options.\nOn the right side of the screen, you can follow the
      match history."
