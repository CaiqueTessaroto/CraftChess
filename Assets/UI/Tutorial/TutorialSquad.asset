%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 16356fe3b9ef6fc4cb033cf0da1bdbec, type: 3}
  m_Name: TutorialSquad
  m_EditorClassIdentifier: 
  pages:
  - image: {fileID: 21300000, guid: ee80f227e5838a840a5e4555493f3338, type: 3}
    description: 'When pressing Add, the available sets will be displayed.

      Choose
      a set to add all of its pieces at once.

      To add pieces individually,
      use the Pieces button in the top-right corner.'
  - image: {fileID: 21300000, guid: db897da984dddc04c837b2bb613ea10a, type: 3}
    description: 'When no piece or button is selected, your squad information appears
      in the center of the screen.

      There you can see the total number of pieces,
      the squad power, and which piece is the King.'
  - image: {fileID: 21300000, guid: 2420db8c7c505a740b42b35150ffb53a, type: 3}
    description: 'Use the crown button to choose which piece will be the King of
      your squad.

      Use the X button to remove a piece from the board.'
  - image: {fileID: 21300000, guid: eb59ac111f29b744cba4fd306b70d81c, type: 3}
    description: 'Select a piece on the right side to see its information in the
      center of the screen.

      Then simply click on the board position where
      you want to place it.'
  - image: {fileID: 21300000, guid: bfb826fa04a4cca4983696b6df5237c9, type: 3}
    description: 'Use the + button to configure promotions and castling for the selected
      piece.

      Simply drag the desired pieces.

      Very powerful pieces have
      limitations: above 25 power they cannot promote, and above 80 power they cannot
      castle.'
  - image: {fileID: 21300000, guid: 28ca66e83923c3a41ae0d4c1c84861f2, type: 3}
    description: The messages displayed below the board indicate the status of Strategic
      Mode. This mode evaluates whether your squad is balanced compared to a classic
      chess set. Although it is possible to save and play with squads outside this
      standard, Strategic Mode is recommended to ensure greater competitiveness.
